  m_Name: LiveMovement
  m_EditorClassIdentifier: Assembly-CSharp::DialougeSO
  voiceClip: {fileID: 8300000, guid: 23da538ad6f882f408e3d833ef27c7a0, type: 3}
  subtitleLines:
  - text: Substantial progress, Initiate.
    startTime: 0
    duration: 1.28
  - text: 'We are transitioning to the final phase of the ballistic course: Live-Entity
      Engagement.'
    startTime: 0
    duration: 6
  - text: Welcome to the Movement Range.
    startTime: 0
    duration: 2
  - text: "Your targets are the 'Undead'\u2014biologically compromised, hyper-hostile,
      and always superior in number."
    startTime: 0
    duration: 7
  - text: Rest easy; these specimens are currently under motor-restriction and sensory-dampening
      protocols. They pose no immediate threat.
    startTime: 0
    duration: 7.21
  - text: 'However, note their behavior: they lack higher cognition, but their auditory
      senses remain acute.'
    startTime: 0
    duration: 7
  - text: They will track the source of any unsuppressed fire.
    startTime: 0
    duration: 3
  - text: Balance your arsenal. Use brute force when cornered, and stealth when navigating
      the shadows.
    startTime: 0
    duration: 7
  - text: The floor is yours, Initiate. Eliminate a few specimens to observe their
      reactions before we proceed.
    startTime: 0
    duration: 7
