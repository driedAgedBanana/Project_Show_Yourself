  voiceClip: {fileID: 8300000, guid: 81011abc1aa58fe4e96832811365d500, type: 3}
  subtitleLines:
  - text: 'Observation: Neutralized entities will de-materialize after a short duration.'
    startTime: 0
    duration: 4
  - text: This is a programmed safeguard to reduce cognitive load on the system.
    startTime: 0
    duration: 4
  - text: "Upon removal, the simulation may cycle and manifest high-value utility
      items in their place\u2014providing tactical rewards for your efficiency."
    startTime: 0
    duration: 9
  - text: Stay vigilant for these drops.
    startTime: 0
    duration: 1.5
  - text: We are approaching the conclusion of your induction, Initiate.
    startTime: 0
    duration: 3
  - text: Your performance has been... noted.
    startTime: 0
    duration: 2
  - text: The final directive involves your Personal Digital Assistant, or PDA.
    startTime: 0
    duration: 5
  - text: This device synchronized with your biometrics to monitor vitals, localized
      mapping, and mission-critical data.
    startTime: 0
    duration: 6.5
  - text: 'Authorization is now active. Open the interface and verify your system
      status. '
    startTime: 0
    duration: 5
